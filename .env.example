# .env cho docker compose trên VPS (cả api lẫn build web đọc file này).
# Sao chép thành .env rồi điền. Không commit .env.

# ---- Cổng trên VPS (reverse proxy của VPS trỏ domain vào đây) ----
FARM_API_PORT=3010
FARM_WEB_PORT=3011

# ---- Hub (api) ----
NODE_ENV=production
# Postgres riêng cho ag-farm. Postgres chạy trên chính VPS: dùng host.docker.internal.
DATABASE_URL=postgresql://ag_farm:CHANGE_ME@host.docker.internal:5432/ag_farm
DATABASE_POOL_MAX=10

# Auth0: cùng tenant và audience với ag-go
AUTH0_ISSUER_URL=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# client id của app Auth0 ag-farm-web
AUTH0_ALLOWED_CLIENT_IDS=your_farm_web_client_id

# Account API (kiểm ADMIN của app ag-farm qua /v2/users/me)
ACCOUNT_API_URL=https://account-api.example.com

# Cặp khoá Ed25519 ký vé job. Sinh bằng:
#   docker compose run --rm --no-deps api node dist/scripts/generate-ticket-keys.js
# Khoá công khai đưa cho ag-go-api và ag-studio (FARM_TICKET_PUBLIC_KEY).
FARM_TICKET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FARM_TICKET_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

REAPER_INTERVAL_MS=15000
NODE_OFFLINE_AFTER_SECONDS=90

# Domain của web quản lý (CORS)
FRONTEND_ORIGIN=https://farm.example.com

# Địa chỉ hub mà máy worker gọi tới: hiện trong lệnh cài máy ở trang Máy (bỏ trống thì web dùng VITE_API_URL)
FARM_PUBLIC_URL=https://farm-api.example.com
# Thư mục trên VPS chứa gói cài worker (zip + latest.json), mount vào api ở /app/releases, phục vụ ở /dist/
FARM_RELEASES_DIR_HOST=./releases
# Model Ollama máy quét cần có (phân cách bởi dấu phẩy): phải trùng ANALYSIS_MODEL của ag-go-api
FARM_OLLAMA_MODELS=qwen2.5vl:7b

# ---- Web quản lý (nhúng lúc build) ----
VITE_API_URL=https://farm-api.example.com
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_farm_web_client_id
VITE_AUTH0_AUDIENCE=https://your-api-audience
