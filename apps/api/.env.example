NODE_ENV=development
PORT=3010

# PostgreSQL
DATABASE_URL=postgresql://farm:farm@localhost:5432/ag_farm
DATABASE_POOL_MAX=10

# Auth0 (cho AdminGuard)
AUTH0_ISSUER_URL=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# Danh sách azp được phép (phân tách bằng dấu phẩy, ví dụ client_id của ag-farm-web)
AUTH0_ALLOWED_CLIENT_IDS=your_auth0_client_id

# Account API
ACCOUNT_API_URL=http://localhost:3001

# Ed25519 ticket keys — sinh bằng: yarn workspace @ag-farm/api keys:generate
# Chấp nhận PEM với literal \n
FARM_TICKET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FARM_TICKET_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Reaper interval (ms)
REAPER_INTERVAL_MS=15000

# Node online threshold (s)
NODE_OFFLINE_AFTER_SECONDS=90

FRONTEND_ORIGIN=http://localhost:5173
